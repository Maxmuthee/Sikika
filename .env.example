# Copy to .env and fill in. NEVER commit the real .env.
# Sikika uses the OpenAI SDK pointed at DeepSeek's OpenAI-compatible API.
SIKIKA_API_KEY=sk-...            # your DeepSeek API key
SIKIKA_BASE_URL=https://api.deepseek.com
SIKIKA_MODEL=deepseek-chat       # or deepseek-reasoner for heavier reasoning

# Database. Leave DATABASE_URL unset to use a local SQLite file (offline demo).
# Set it to your Neon connection string to use PostgreSQL (production).
# DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/sikika?sslmode=require

# Public base URL used to build clickable bill links in SMS. Set to your real
# domain (or ngrok URL) in production so smartphone users can tap through.
SIKIKA_PUBLIC_URL=http://localhost:8000

# Africa's Talking (sandbox). Leave blank to log SMS locally (simulator still works).
AT_USERNAME=sandbox
AT_API_KEY=                      # sandbox API key from the AT dashboard
# AT_SENDER=                     # optional; leave blank in sandbox
